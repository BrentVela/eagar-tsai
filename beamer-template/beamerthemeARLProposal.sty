\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeARLProposal}[2026/07/07 Texas A&M-inspired Beamer theme]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{siunitx}
\usetikzlibrary{arrows.meta,calc,fit,positioning,shapes.geometric}

\mode<presentation>

\usetheme{Madrid}
\usecolortheme{seahorse}
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{footline}[frame number]

\definecolor{aggiemaroon}{RGB}{80,0,0}
\definecolor{aggiemaroonlight}{RGB}{124,37,41}
\definecolor{aggietan}{RGB}{208,196,170}
\definecolor{aggiegray}{RGB}{112,115,114}
\definecolor{aggiecharcoal}{RGB}{51,47,44}
\definecolor{aggiecream}{RGB}{248,245,240}
\definecolor{aggiegold}{RGB}{166,123,58}
\definecolor{aggiesky}{RGB}{121,160,191}
\definecolor{aggierust}{RGB}{178,74,52}
\definecolor{aggieforest}{RGB}{72,96,77}

\setbeamercolor{proposal header}{fg=white,bg=aggiemaroon}
\setbeamercolor{structure}{fg=aggiemaroon}
\setbeamercolor{frametitle}{fg=white,bg=aggiemaroon}
\setbeamercolor{title}{fg=white,bg=aggiemaroon}
\setbeamercolor{block title}{fg=white,bg=aggiecharcoal}
\setbeamercolor{block body}{bg=aggietan!18}
\setbeamercolor{alertblock title}{fg=white,bg=aggiemaroonlight}
\setbeamercolor{alertblock body}{bg=aggiemaroon!8}
\setbeamercolor{alerted text}{fg=aggiegold}
 \setbeamercolor{item projected}{fg=white,bg=aggiemaroon}

\newcommand{\proposalprefix}{TEXAS A\&M}
\newcommand{\setproposalprefix}[1]{\renewcommand{\proposalprefix}{#1}}

\setbeamertemplate{headline}{
  \leavevmode%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.0ex,dp=1.1ex,leftskip=1em,rightskip=1em]{proposal header}
    \textbf{\proposalprefix}\hspace{0.9em}\insertshorttitle
    \hfill \insertshortauthor
  \end{beamercolorbox}%
}

\newcommand{\stage}[1]{\textcolor{aggiemaroon}{\textbf{#1}}}
\newcommand{\deliverable}[1]{\textcolor{aggieforest}{\textbf{#1}}}
\newcommand{\risk}[1]{\textcolor{aggiegold}{\textbf{#1}}}

\newcommand{\ARLGradientLegend}[6]{
  \begin{tikzpicture}
    \node[anchor=west, font=\scriptsize\bfseries] at (0,1.75) {#1};
    \shade[bottom color=#2,top color=#3] (0,0) rectangle (10.0,1.4);
    \draw[line width=1.2pt, draw=black!85] (0,0) rectangle (10.0,1.4);

    \shade[bottom color=#2,top color=#3] (10.7,-0.05) rectangle (11.35,1.45);
    \draw[line width=1.0pt, draw=black!85] (10.7,-0.05) rectangle (11.35,1.45);

    \node[anchor=west, align=left, font=\scriptsize] at (11.55,1.45) {#4};
    \node[anchor=west, align=left, font=\scriptsize] at (11.55,-0.05) {#5};
    \node[anchor=west, align=left, font=\scriptsize, text=black!70] at (0,-0.65) {#6};
  \end{tikzpicture}
}

\newcommand{\ARLTitleGraphic}{
  \begin{tikzpicture}[x=\textwidth,y=2.2cm]
    \fill[aggiecream] (0,0) rectangle (1,1);
    \shade[left color=aggiemaroon,right color=aggiemaroonlight] (0.02,0.58) rectangle (0.98,0.9);
    \shade[left color=aggiecharcoal,right color=aggiegold] (0.02,0.33) rectangle (0.82,0.53);
    \shade[left color=aggiesky,right color=aggierust] (0.18,0.08) rectangle (0.98,0.28);
    \draw[white,line width=1.2pt] (0.08,0.74) -- (0.92,0.74);
    \draw[white,line width=1.2pt] (0.14,0.43) -- (0.76,0.43);
    \draw[white,line width=1.2pt] (0.24,0.18) -- (0.92,0.18);
    \node[anchor=west,text=white,font=\bfseries\footnotesize] at (0.04,0.94) {Texas A\&M research};
    \node[anchor=west,text=white,font=\bfseries\footnotesize] at (0.04,0.57) {Engineering systems};
    \node[anchor=west,text=white,font=\bfseries\footnotesize] at (0.20,0.32) {Data and design};
  \end{tikzpicture}
}

\mode<all>
