\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeARLProposal}[2026/07/07 SFF-compatible Beamer theme]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{siunitx}
\usetikzlibrary{arrows.meta,calc,fit,positioning,shapes.geometric}

\mode<presentation>

\usetheme{Madrid}
\usecolortheme{seahorse}
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{background}{
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south,inner sep=0pt] at (current page.south) {
      \includegraphics[width=\paperwidth,height=0.5556in]{sff_footer.jpeg}
    };
  \end{tikzpicture}
}
\setbeamertemplate{footline}{
  \begin{tikzpicture}[remember picture,overlay]
    \node[
      anchor=south east,
      text=white,
      font=\fontsize{9}{11}\selectfont\bfseries
    ] at ([xshift=-0.32in,yshift=0.15in]current page.south east) {\insertframenumber};
  \end{tikzpicture}
}
\setbeamertemplate{title page}{
  \vbox{}
  \vfill
  \begin{centering}
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \vspace{0.28in}
    {\color{sffline}\rule{0.72\paperwidth}{1.2pt}\par}
    \vspace{0.36in}
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
    \vspace{0.18in}
    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
    \vspace{0.12in}
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
  \end{centering}
  \vfill
}

\setbeamerfont{normal text}{size=\fontsize{16}{20}\selectfont}
\setbeamerfont{title}{size=\fontsize{30}{36}\selectfont,series=\bfseries}
\setbeamerfont{subtitle}{size=\fontsize{18}{22}\selectfont}
\setbeamerfont{author}{size=\fontsize{22}{27}\selectfont}
\setbeamerfont{institute}{size=\fontsize{18}{22}\selectfont}
\setbeamerfont{date}{size=\fontsize{18}{22}\selectfont}
\setbeamerfont{frametitle}{size=\fontsize{30}{36}\selectfont,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{18}{22}\selectfont}
\setbeamerfont{headline}{size=\scriptsize,series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{block title}{size=\fontsize{17}{21}\selectfont,series=\bfseries}
\setbeamerfont{block body}{size=\fontsize{16}{20}\selectfont}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{16}{20}\selectfont}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{15}{19}\selectfont}
\setbeamerfont{itemize/enumerate subsubbody}{size=\fontsize{15}{18}\selectfont}
\setbeamerfont{caption}{size=\fontsize{15}{18}\selectfont}

\definecolor{sffblue}{RGB}{68,130,190}
\definecolor{sffbluegray}{RGB}{92,116,142}
\definecolor{sffred}{RGB}{191,77,59}
\definecolor{sffcream}{RGB}{249,244,232}
\definecolor{sffline}{RGB}{170,194,220}
\definecolor{neutraldark}{RGB}{33,37,41}
\definecolor{neutralmid}{RGB}{92,96,100}
\definecolor{neutrallight}{RGB}{244,246,248}

\setbeamercolor{normal text}{fg=neutraldark,bg=white}
\setbeamercolor{proposal header}{fg=neutraldark,bg=white}
\setbeamercolor{structure}{fg=sffblue}
\setbeamercolor{frametitle}{fg=neutraldark,bg=white}
\setbeamercolor{title}{fg=neutraldark,bg=white}
\setbeamercolor{subtitle}{fg=neutralmid,bg=white}
\setbeamercolor{author}{fg=neutraldark,bg=white}
\setbeamercolor{institute}{fg=neutralmid,bg=white}
\setbeamercolor{date}{fg=neutralmid,bg=white}
\setbeamercolor{block title}{fg=neutraldark,bg=sffline!45}
\setbeamercolor{block body}{fg=neutraldark,bg=neutrallight}
\setbeamercolor{alertblock title}{fg=white,bg=sffred}
\setbeamercolor{alertblock body}{fg=neutraldark,bg=sffred!8}
\setbeamercolor{alerted text}{fg=sffred}
\setbeamercolor{item projected}{fg=white,bg=sffblue}

\newcommand{\proposalprefix}{SFF}
\newcommand{\setproposalprefix}[1]{\renewcommand{\proposalprefix}{#1}}

\setbeamertemplate{headline}{}

\newcommand{\stage}[1]{\textcolor{sffblue}{\textbf{#1}}}
\newcommand{\deliverable}[1]{\textcolor{sffbluegray}{\textbf{#1}}}
\newcommand{\risk}[1]{\textcolor{sffred}{\textbf{#1}}}

\newcommand{\ARLGradientLegend}[6]{
  \begin{tikzpicture}
    \node[anchor=west, font=\fontsize{15}{18}\selectfont\bfseries] at (0,1.75) {#1};
    \shade[bottom color=#2,top color=#3] (0,0) rectangle (10.0,1.4);
    \draw[line width=1.2pt, draw=black!85] (0,0) rectangle (10.0,1.4);

    \shade[bottom color=#2,top color=#3] (10.7,-0.05) rectangle (11.35,1.45);
    \draw[line width=1.0pt, draw=black!85] (10.7,-0.05) rectangle (11.35,1.45);

    \node[anchor=west, align=left, font=\fontsize{15}{18}\selectfont] at (11.55,1.45) {#4};
    \node[anchor=west, align=left, font=\fontsize{15}{18}\selectfont] at (11.55,-0.05) {#5};
    \node[anchor=west, align=left, font=\fontsize{15}{18}\selectfont, text=black!70] at (0,-0.65) {#6};
  \end{tikzpicture}
}

\newcommand{\ARLTitleGraphic}{
  \begin{tikzpicture}[x=\textwidth,y=2.2cm]
    \fill[sffcream] (0,0) rectangle (1,1);
    \shade[left color=sffblue,right color=sffline] (0.02,0.58) rectangle (0.98,0.9);
    \shade[left color=neutraldark,right color=sffbluegray] (0.02,0.33) rectangle (0.82,0.53);
    \shade[left color=sffline,right color=sffred] (0.18,0.08) rectangle (0.98,0.28);
    \draw[white,line width=1.2pt] (0.08,0.74) -- (0.92,0.74);
    \draw[white,line width=1.2pt] (0.14,0.43) -- (0.76,0.43);
    \draw[white,line width=1.2pt] (0.24,0.18) -- (0.92,0.18);
    \node[anchor=west,text=white,font=\bfseries\fontsize{16}{20}\selectfont] at (0.04,0.94) {Texas A\&M research};
    \node[anchor=west,text=white,font=\bfseries\fontsize{16}{20}\selectfont] at (0.04,0.57) {Engineering systems};
    \node[anchor=west,text=white,font=\bfseries\fontsize{16}{20}\selectfont] at (0.20,0.32) {Data and design};
  \end{tikzpicture}
}

\mode<all>
